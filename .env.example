# ============================================================
# Drive2Social Publisher — example environment variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- Backend server ---
PORT=8080
FRONTEND_URL=http://localhost:5173
# Optional: pino log level (fatal|error|warn|info|debug|trace). Default: info.
LOG_LEVEL=info

# --- Google OAuth (Drive + YouTube) ---
# REDIRECT_URI must exactly match the authorized redirect URI registered in
# Google Cloud Console for this OAuth client. It must be the /callback route
# below (Phase 3): GET /api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# --- Meta (Facebook Pages) OAuth ---
# META_REDIRECT_URI must be registered in the Meta App Dashboard under
# Facebook Login → Settings → Valid OAuth Redirect URIs.
# Verified 2026-10-01: v22.0 is still supported (until 2027-05-20); the
# latest stable version is v26.0 (released 2026-07-29). Keep v22.0 or
# bump to v26.0 here — the upload flow is identical across versions.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_GRAPH_VERSION=v22.0
META_REDIRECT_URI=http://localhost:8080/api/auth/meta/callback

# --- Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key
# Server-default model (a per-user override can be set in the UI under
# Settings, constrained to the allowlist in shared/src/index.ts).
GEMINI_MODEL=gemini-2.0-flash

# --- Firebase (server-side: firebase-admin) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Token encryption (OAuth tokens at rest) ---
# Must resolve to exactly 32 bytes. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=your-32-byte-base64-key

# --- Frontend (Vite; VITE_ prefix required) ---
VITE_API_URL=http://localhost:8080
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
